{
  "manifest_version": 3,
  "name": "Prompt Firewall",
  "version": "0.1.0",
  "description": "Scrubs sensitive content out of AI chat prompts before they leave your machine. Everything that decides runs locally.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://*.huggingface.co/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "src/content/content-script.ts"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Prompt Firewall"
  },
  "options_page": "src/options/index.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ort/*"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}
