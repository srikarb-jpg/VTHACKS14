{
  "manifest_version": 3,
  "name": "Prompt Firewall",
  "version": "0.1.0",
  "description": "Scrubs sensitive content out of AI chat prompts before they leave your machine. Everything that decides runs locally.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Prompt Firewall"
  },
  "options_page": "src/options/index.html"
}
